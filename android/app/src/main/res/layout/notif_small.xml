<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical">
    <ImageView android:id="@+id/n_logo" android:layout_width="38dp" android:layout_height="38dp"
        android:src="@mipmap/ic_launcher" android:layout_marginEnd="12dp" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/n_over" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="11sp" android:textStyle="bold" android:textColor="#6B5BD6" android:letterSpacing="0.06" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/n_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="15sp" android:textStyle="bold" android:textColor="#141414" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/n_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12.5sp" android:textColor="#6E6B7B" android:singleLine="true" android:ellipsize="end" />
    </LinearLayout>
    <FrameLayout android:id="@+id/n_ringbox" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="8dp">
        <ProgressBar android:id="@+id/n_ring" style="?android:attr/progressBarStyleHorizontal" android:layout_width="44dp" android:layout_height="44dp"
            android:progressDrawable="@drawable/n_ring" android:indeterminate="false" android:max="100" />
        <ProgressBar android:id="@+id/n_ring_ok" style="?android:attr/progressBarStyleHorizontal" android:layout_width="44dp" android:layout_height="44dp"
            android:progressDrawable="@drawable/n_ring_ok" android:indeterminate="false" android:max="100" android:visibility="gone" />
        <TextView android:id="@+id/n_ringtxt" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center"
            android:textSize="11.5sp" android:textStyle="bold" android:textColor="#141414" />
    </FrameLayout>
    <TextView android:id="@+id/n_serial" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
        android:textSize="17sp" android:textColor="#6E6B7B" android:visibility="gone" />
</LinearLayout>
