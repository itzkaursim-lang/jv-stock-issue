<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:background="@drawable/n_hero" android:padding="10dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@mipmap/ic_launcher" android:layout_marginEnd="10dp" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/b_over" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="10.5sp" android:textStyle="bold" android:textColor="#6B5BD6" android:letterSpacing="0.08" android:singleLine="true" />
                <TextView android:id="@+id/b_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="15.5sp" android:textStyle="bold" android:textColor="#141414" android:singleLine="true" android:ellipsize="end" />
            </LinearLayout>
            <FrameLayout android:id="@+id/b_ringbox" android:layout_width="40dp" android:layout_height="40dp">
                <ProgressBar android:id="@+id/b_ring" style="?android:attr/progressBarStyleHorizontal" android:layout_width="40dp" android:layout_height="40dp"
                    android:progressDrawable="@drawable/n_ring" android:indeterminate="false" android:max="100" />
                <ProgressBar android:id="@+id/b_ring_ok" style="?android:attr/progressBarStyleHorizontal" android:layout_width="40dp" android:layout_height="40dp"
                    android:progressDrawable="@drawable/n_ring_ok" android:indeterminate="false" android:max="100" android:visibility="gone" />
                <TextView android:id="@+id/b_ringtxt" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center"
                    android:textSize="11sp" android:textStyle="bold" android:textColor="#141414" />
            </FrameLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical"
                android:background="@drawable/n_tile" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="5dp" android:paddingBottom="5dp" android:layout_marginEnd="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="REQUEST" android:textSize="9.5sp" android:textStyle="bold" android:textColor="#8A87A0" />
                <TextView android:id="@+id/b_req" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp" android:textStyle="bold" android:textColor="#4B3BA8" android:singleLine="true" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical"
                android:background="@drawable/n_tile" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="5dp" android:paddingBottom="5dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SLIP" android:textSize="9.5sp" android:textStyle="bold" android:textColor="#8A87A0" />
                <TextView android:id="@+id/b_slip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp" android:textStyle="bold" android:textColor="#141414" android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/b_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/n_now" android:padding="9dp" android:layout_marginTop="8dp">
        <ImageView android:id="@+id/b_cardic" android:layout_width="30dp" android:layout_height="30dp" android:padding="6dp" android:background="@drawable/n_ic_lav" android:src="@drawable/ic_n_plus" android:layout_marginEnd="10dp" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/b_now" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" android:textColor="#FFFFFF" android:singleLine="true" android:ellipsize="end" />
            <TextView android:id="@+id/b_nowsub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11.5sp" android:textColor="#C9C5D6" android:singleLine="true" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/b_serial" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="17sp" android:textColor="#6E6B7B" android:visibility="gone" />
    </LinearLayout>
    <ProgressBar android:id="@+id/b_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp"
        android:layout_marginTop="8dp" android:progressDrawable="@drawable/n_bar" android:max="100" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="3dp">
        <TextView android:id="@+id/b_metal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="11sp" android:textStyle="bold" android:textColor="#8A87A0" android:singleLine="true" />
        <TextView android:id="@+id/b_metar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textStyle="bold" android:textColor="#8A87A0" android:singleLine="true" />
    </LinearLayout>
    <LinearLayout android:id="@+id/b_acts" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
        <TextView android:id="@+id/b_btn1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:gravity="center" android:background="@drawable/n_btn_dark" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:layout_marginEnd="6dp" />
        <TextView android:id="@+id/b_btn2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:gravity="center" android:background="@drawable/n_btn_soft" android:textColor="#141414" android:textSize="13sp" android:textStyle="bold" android:layout_marginEnd="6dp" />
        <TextView android:id="@+id/b_btn3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:gravity="center" android:background="@drawable/n_btn_red" android:textColor="#C0264A" android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
